# Reldens environment configuration (example)
# Copy this file to .env and adjust the values for your environment.

# Blockchain (Solana wallet link, token balance, NFT ownership):
# Solana RPC URL used by the token balance reads and NFT verification (server only):
RELDENS_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Token mint address for holder-tier balance reads (no default - unset disables balance reads):
RELDENS_TOKEN_MINT=""
# Token max supply used by the holder-tier ladder percentages (default: 1000000000):
RELDENS_TOKEN_MAX_SUPPLY=1000000000
# Disable the wallet link feature (1 = disabled):
RELDENS_WALLET_DISABLED=0
# NFT identity constants for Token-2022 ownership verification (defaults to the CloudCraft SGT identity):
RELDENS_NFT_MINT_AUTHORITY="GT2zuHVaZQYZSyQMgJPLzvkmyztfyXg2NJunqFp4p3A4"
RELDENS_NFT_METADATA_ADDRESS="GT22s89nU4iWFkNXj1Bw6uYhJJWDRPpShHt4Bk8f99Te"
RELDENS_NFT_GROUP_ADDRESS="GT22s89nU4iWFkNXj1Bw6uYhJJWDRPpShHt4Bk8f99Te"
# Comma-separated trusted proxy IPs for X-Forwarded-For resolution (empty = private/loopback default):
RELDENS_TRUSTED_PROXY_IPS=""

# Economy service pass-through proxy (server only):
# The game server forwards balance/price/purchase/spend/store/history to an
# external soft-currency economy service over a secret-gated internal API. If
# either value is unset the proxy is disabled and every call degrades to a
# typed "unavailable" result without throwing.
# Base URL of the external economy service (no default - unset disables the proxy):
RELDENS_ECONOMY_SERVICE_URL=""
# Shared secret the game server sends in the x-reldens-economy-secret header (no default):
RELDENS_ECONOMY_INTERNAL_SECRET=""

# Wallet Connect (Reown AppKit) - optional external Solana wallet app / QR flow
# on the client login screen. Without a project id the "Wallet app / QR" option
# is hidden entirely.
# Reown project id from https://cloud.reown.com (no default - unset hides the option):
RELDENS_REOWN_PROJECT_ID=""
# Allow the wallet connect flow (1 = enabled):
RELDENS_WALLET_CONNECT_ENABLED=1

# Economy service (reference deployment in services/economy-service):
# The reference economy service is a separate process. These env vars configure
# THAT process, not the game server (the game connects via
# RELDENS_ECONOMY_SERVICE_URL / RELDENS_ECONOMY_INTERNAL_SECRET above).
# HTTP port the economy service listens on (default: 8301):
ECONOMY_SERVICE_PORT=8301
# Internal secret the economy service requires in the x-reldens-economy-secret
# header. Must match RELDENS_ECONOMY_INTERNAL_SECRET on the game server:
ECONOMY_INTERNAL_SECRET=""

# Branding:
# Comma-separated holder-tier keys, exactly 18 entries, mapped positionally onto
# the fixed threshold ladder. Empty/invalid falls back to the defaults:
RELDENS_HOLDER_TIER_KEYS="ember,coinbearer,coppercrest,silverbound,gilded,vaultwarden,whale,leviathan,tidelord,stormcaller,krakencrown,titanforged,starhoard,voidwarden,realmshaper,worldforger,worldbearer,sovereign"
# Game name used in wallet-link challenge messages and client branding
# (read by the blockchain wallet-link flow; default: Reldens):
RELDENS_GAME_NAME="Reldens"
